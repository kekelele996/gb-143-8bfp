{
  "name": "volunteer-points-credit",
  "version": "1.0.0",
  "description": "志愿者积分与信用评估系统",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "ts-node src/db/migrate.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test:credit-limit": "ts-node src/tests/creditLimit.test.ts",
    "test:credit-calc": "ts-node src/tests/creditCalculation.test.ts",
    "test:appeal-flow": "DB_HOST=localhost DB_PORT=5743 DB_NAME=volunteer_db DB_USER=postgres DB_PASSWORD=postgres ts-node src/tests/appealFlow.test.ts"
  },
  "dependencies": {
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.54.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
